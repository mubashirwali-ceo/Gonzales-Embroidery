rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // >>> CHANGE THIS to the same email you put in assets/js/config.js (ADMIN_EMAIL) <<<
    function isAdmin()  { return verified() && request.auth.token.email == 'mhrsunny2019@gmail.com'; }

    // Client profiles: each client reads/edits only their own; admin reads all.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['clientId','name','email','phone','address','work','createdAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','address','work']);
      allow delete: if false;
    }

    // Counter used to give sequential client IDs (GE-1001, GE-1002 ...)
    match /meta/clientCounter {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.n == 1;
      allow update: if signedIn() && request.resource.data.n == resource.data.n + 1;
    }

    // Orders: client creates and reads only their own; only admin changes price/status/payment.
    match /orders/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if verified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'New'
        && request.resource.data.price == 0
        && request.resource.data.paid == 0;
      allow update, delete: if isAdmin();
    }

    // Quote requests from the public website form: anyone can send, only admin can read.
    match /quotes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','company','details','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.details is string && request.resource.data.details.size() <= 4000
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
  }
}
